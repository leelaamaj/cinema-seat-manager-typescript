{
  "name": "cinema-seat-manager-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cinema reservations using TypeScript arrays and functions",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "console": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.20.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.3.7"
  }
}
